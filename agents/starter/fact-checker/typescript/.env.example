# Required: Your Anthropic API key - get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Required: Your Tavily API key - get one at https://tavily.com
TAVILY_API_KEY=your-tavily-api-key-here

# Optional: Override the default model (default: claude-sonnet-4-20250514)
# MODEL=claude-sonnet-4-20250514


# Required: Your Reader API key
# Get one at: https://reader.dev
READER_API_KEY=your-reader-api-key-here
